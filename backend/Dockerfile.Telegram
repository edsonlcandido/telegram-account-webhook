# =============================================================================
# Dockerfile.Telegram
# Sobe: FastAPI + Telethon (Backend Telegram)
# URL interna Easypanel: http://telegram-api:8000
# Comunica com PocketBase via: http://pocketbase:8090 (rede interna)
# =============================================================================

FROM python:3.11-slim

LABEL maintainer="Edson <edson@ehtudo.app>"

WORKDIR /app

# -----------------------------------------------------------------------------
# Dependências do sistema (telethon/cryptography + Pillow JPEG/PNG/WebP)
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libpng-dev \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python deps
# -----------------------------------------------------------------------------
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# -----------------------------------------------------------------------------
# Código
# -----------------------------------------------------------------------------
COPY backend/ .

# -----------------------------------------------------------------------------
# Segurança: usuário não-root
# -----------------------------------------------------------------------------
RUN useradd --create-home --shell /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health').raise_for_status()" || exit 1

# -----------------------------------------------------------------------------
# Variáveis de ambiente (configure no Easypanel):
#   POCKETBASE_URL=http://pocketbase:8090  (URL interna)
#   TG_API_ID=seu_api_id
#   TG_API_HASH=seu_api_hash
# -----------------------------------------------------------------------------
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
