# =============================================================================
# Dockerfile.Application
# Sobe: Landing Page + Vue Web App + PocketBase
# URL: https://telegram-webhook.ehtudo.app/
# =============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Dependências npm
COPY package*.json ./
RUN npm ci

# Código fonte
COPY apps/ ./apps/

# Build landing + web app
RUN npm run build:landing --prefix apps/landing
RUN npm run build:web --prefix apps/web

# -----------------------------------------------------------------------------
FROM alpine:3.19 AS production

WORKDIR /app

# Baixa e extrai PocketBase
RUN apk add --no-cache curl unzip && \
    curl -L -o pocketbase.zip https://github.com/pocketbase/pocketbase/releases/download/v0.22.18/pocketbase_0.22.18_linux_amd64.zip && \
    unzip pocketbase.zip && \
    rm pocketbase.zip && \
    chmod +x pocketbase

# Copia frontend buildado
COPY --from=builder /app/apps/landing/dist /app/public
COPY --from=builder /app/apps/web/dist /app/public/app

# Hooks
COPY pocketbase/pb_hooks /app/pb_hooks

# Dados
VOLUME ["/app/pb_data"]

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8090/api/health || exit 1

ENTRYPOINT ["/app/pocketbase"]
CMD ["serve", "--http=0.0.0.0:8090", "--dirs=/app/public"]
