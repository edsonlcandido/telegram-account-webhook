# =============================================================================
# Dockerfile.Application
# Sobe: Landing Page + Vue Web App + PocketBase
# =============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Landing
COPY apps/landing/package.json apps/landing/
COPY apps/landing/tsconfig.json apps/landing/
COPY apps/landing/vite.config.ts apps/landing/
COPY apps/landing/src apps/landing/src/
COPY apps/landing/index.html apps/landing/
COPY apps/landing/tailwind.config.js apps/landing/
COPY apps/landing/postcss.config.js apps/landing/
RUN cd apps/landing && npm install && npm run build

# Web App
COPY apps/web/package.json apps/web/
COPY apps/web/tsconfig.json apps/web/
COPY apps/web/vite.config.ts apps/web/
COPY apps/web/src apps/web/src/
COPY apps/web/index.html apps/web/
COPY apps/web/tailwind.config.js apps/web/
COPY apps/web/postcss.config.js apps/web/
RUN cd apps/web && npm install && npm run build

# -----------------------------------------------------------------------------
FROM alpine:3.19 AS production

WORKDIR /app

# Baixa e extrai PocketBase
RUN apk add --no-cache curl unzip && \
    curl -L -o pocketbase.zip https://github.com/pocketbase/pocketbase/releases/download/v0.22.18/pocketbase_0.22.18_linux_amd64.zip && \
    unzip pocketbase.zip && \
    rm pocketbase.zip && \
    chmod +x pocketbase

# Copia frontend buildado
COPY --from=builder /app/apps/landing/dist /app/public
COPY --from=builder /app/apps/web/dist /app/public/app

# Hooks
COPY pocketbase/pb_hooks /app/pb_hooks

# Dados
VOLUME ["/app/pb_data"]

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8090/api/health || exit 1

ENTRYPOINT ["/app/pocketbase"]
CMD ["serve", "--http=0.0.0.0:8090", "--dirs=/app/public"]
