# =============================================================================
# Dockerfile.Application
# Sobe: Landing Page + Vue Web App + PocketBase
# URL: https://telegram-webhook.ehtudo.app/
# =============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Dependências npm
COPY package*.json ./
RUN npm ci

# Código fonte
COPY apps/ ./apps/

# Build landing + web app
RUN npm run build:landing --prefix apps/landing
RUN npm run build:web --prefix apps/web

# -----------------------------------------------------------------------------
FROM pocketbase/pocketbase:latest AS production

WORKDIR /app

# Copia arquivos estáticos
COPY --from=builder /app/apps/landing/dist /pb_public
COPY --from=builder /app/apps/web/dist /pb_public/app

# Hooks customizados
COPY pocketbase/pb_hooks /pb_hooks

# Pasta para dados (volume externo)
VOLUME ["/pb_data"]

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8090/api/health || exit 1

ENTRYPOINT ["/pocketbase"]
CMD ["serve", "--http=0.0.0.0:8090"]
