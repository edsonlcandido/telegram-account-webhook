{
  "name": "telegram_sessions",
  "type": "base",
  "listRule": "@request.auth.id != ''",
  "viewRule": "@request.auth.id != ''",
  "createRule": "@request.auth.id != ''",
  "updateRule": "@request.auth.id != ''",
  "deleteRule": "@request.auth.id != ''",
  "schema": [
    {
      "system": false,
      "name": "phone",
      "type": "text",
      "required": true,
      "options": {
        "min": 10,
        "max": 20
      }
    },
    {
      "system": false,
      "name": "session_id",
      "type": "text",
      "required": true,
      "options": {
        "min": 1,
        "max": 255
      }
    },
    {
      "system": false,
      "name": "phone_code_hash",
      "type": "text",
      "required": false,
      "options": {
        "max": 255
      }
    },
    {
      "system": false,
      "name": "webhook_url",
      "type": "url",
      "required": false,
      "options": {
        "exceptDomains": [],
        "onlyDomains": [],
        "preview": true
      }
    },
    {
      "system": false,
      "name": "active",
      "type": "bool",
      "required": false
    },
    {
      "system": false,
      "name": "api_id",
      "type": "number",
      "required": false,
      "options": {
        "noDecimals": true
      }
    },
    {
      "system": false,
      "name": "api_hash",
      "type": "text",
      "required": false,
      "options": {
        "max": 255
      }
    }
  ],
  "indexes": [
    "CREATE UNIQUE INDEX idx_telegram_sessions_session_id ON telegram_sessions (session_id)",
    "CREATE UNIQUE INDEX idx_telegram_sessions_phone ON telegram_sessions (phone)"
  ]
}
