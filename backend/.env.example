# =============================================================================
# Variáveis de ambiente - NÃO COMMITAR VALORES REAIS!
# =============================================================================

# Telegram API (obtenha em https://my.telegram.org)
TG_API_ID=12345
TG_API_HASH=your_api_hash_here

# PocketBase
POCKETBASE_URL=http://localhost:8090

# =============================================================================
# Service token do PB — autenticação ÚNICA usada por todos os fluxos em
# background (handler do Telethon, jobs em background).
#
# Origem do token (em ordem de preferência):
#   1) POCKETBASE_SERVICE_TOKEN (abaixo) — JWT pronto, sem senha em env.
#      Gerar uma vez no admin UI do PB: faça login como superuser, copie
#      o JWT da response, cole aqui. Token default dura 14 dias.
#   2) POCKETBASE_ADMIN_EMAIL + POCKETBASE_ADMIN_PASSWORD — login automático
#      via /_superusers/auth-with-password no startup do container.
#
# Sem um dos dois configurados, o backend SUBIR MAS VAI DROPPAR TODA
# MENSAGEM QUE CHEGAR (handler do Telethon precisa do token pra inserir
# em telegram_messages, e a createRule dessa collection exige auth).
# =============================================================================

# Opção 1: JWT pronto (recomendado pra produção)
POCKETBASE_SERVICE_TOKEN=

# Opção 2: creds de superuser (login automático no startup)
# Use um superuser dedicado pra esse serviço, não o seu pessoal.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# CORS — lista CSV de origens permitidas.
# Em produção (Easypanel com proxy na mesma origem) pode ficar vazio,
# mas mantenha o domínio público aqui se for servir o frontend em outro host.
# Ex.: ALLOWED_ORIGINS=https://telegram-webhook.ehtudo.app
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:5173,http://localhost:5174
